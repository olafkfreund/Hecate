/bin/
/dist/

# `go build ./cmd/X` writes ./X, not into bin/. Named rather than globbed:
# a pattern broad enough to catch these would also catch a future directory.
/hecate
/hecate-api
/hecate-controller
/hecate-mcp

*.test
coverage.out
.env
node_modules/
.next/

# local dev cluster state
.dev/
bin/
result
result-*
.direnv/

# The built UI is a build artifact, not source. `make ui` produces it; the
# placeholder that keeps `go build ./...` working is committed instead.
pkg/api/ui/*
!pkg/api/ui/.gitkeep

# Coding agents check out branches into worktrees here. They are whole copies
# of this repository, so an unlucky `git add -A` commits the tree into itself.
.claude/worktrees/
